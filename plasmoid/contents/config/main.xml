<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
     http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <!-- Skins Section -->
        <entry name="skin" type="Enum">
            <label>Skin type</label>
            <choices>
                <choice name="Standard"/>
                <choice name="Column"/>
                <choice name="Minimalistic"/>
            </choices>
            <default>0</default>
        </entry>

        <!-- Background Section -->
        <entry name="bgColor" type="Enum">
            <label>Background color</label>
            <choices>
                <choice name="Standard"/>
                <choice name="Crystal"/>
                <choice name="Translucent"/>
            </choices>
            <default>1</default>
        </entry>

        <!-- Logos Section -->
        <entry name="logo" type="Enum">
            <label>Distribution logo</label>
            <choices>
                <choice name="Default"/>
                <choice name="Tux"/>
                <choice name="Slackware"/>
                <choice name="Ubuntu"/>
                <choice name="Kubuntu"/>
                <choice name="OpenSUSE"/>
                <choice name="Manjaro"/>
                <choice name="Arch"/>
                <choice name="Fedora"/>
                <choice name="Debian"/>
                <choice name="Linux Mint"/>
                <choice name="EndeavourOS"/>
                <choice name="Pop!_OS"/>
                <choice name="Zorin OS"/>
                <choice name="elementary OS"/>
                <choice name="NixOS"/>
                <choice name="Gentoo"/>
                <choice name="Alpine"/>
                <choice name="Void"/>
                <choice name="Rocky"/>
                <choice name="AlmaLinux"/>
                <choice name="Red Hat"/>
                <choice name="CentOS"/>
                <choice name="Kali"/>
                <choice name="blackPanther OS"/>
                <choice name="KDE neon"/>
                <choice name="Custom"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="customLogo" type="String">
            <label>Custom logo file</label>
            <default></default>
        </entry>
        <entry name="logoScale" type="Double">
            <label>Logo scaling</label>
            <default>1.0</default>
        </entry>

        <!-- New options retain the previous presentation by default. -->
        <entry name="showLogo" type="Bool"><label>Show logo</label><default>true</default></entry>
        <entry name="showDistroName" type="Bool"><label>Show distribution name</label><default>true</default></entry>
        <entry name="showDistroVersion" type="Bool"><label>Show distribution version</label><default>true</default></entry>
        <entry name="showDistroCodename" type="Bool"><label>Show distribution codename</label><default>true</default></entry>
        <entry name="distroLayout" type="Enum">
            <label>Distribution information layout</label>
            <choices><choice name="OneLine"/><choice name="SeparateLines"/></choices><default>0</default>
        </entry>
        <entry name="showCpuFrequency" type="Bool"><label>Show CPU frequency</label><default>false</default></entry>
        <entry name="autoFitContent" type="Bool"><label>Fit size to content</label><default>false</default></entry>
        <entry name="compactLayout" type="Bool"><label>Compact layout</label><default>false</default></entry>
        <entry name="dateVisibility" type="Enum">
            <label>Date visibility</label>
            <choices><choice name="AccordingToSkin"/><choice name="Show"/><choice name="Hide"/></choices>
            <default>0</default>
        </entry>
        <entry name="timeVisibility" type="Enum">
            <label>Time visibility</label>
            <choices><choice name="AccordingToSkin"/><choice name="Show"/><choice name="Hide"/></choices>
            <default>0</default>
        </entry>
        <entry name="cpuColumns" type="Int">
            <label>CPU columns (0 for automatic)</label><min>0</min><max>8</max><default>1</default>
        </entry>

        <!-- Displays Section -->
        <entry name="showGpuTemp" type="Bool">
            <label>Show GPU Temperature</label>
            <default>true</default>
        </entry>
        <entry name="showSwap" type="Bool">
            <label>Show Swap</label>
            <default>true</default>
        </entry>
        <entry name="showUptime" type="Bool">
            <label>Show Uptime</label>
            <default>true</default>
        </entry>
        <entry name="showNetwork" type="Bool">
            <label>Show Network</label>
            <default>true</default>
        </entry>
        <entry name="showPing" type="Bool">
            <label>Show the ping to a host</label>
            <default>false</default>
        </entry>
        <entry name="pingHost" type="String">
            <label>Host to ping</label>
            <default>1.1.1.1</default>
        </entry>
        <entry name="netUnit" type="Enum">
            <label>Network speed unit</label>
            <choices>
                <choice name="Bytes per second"/>
                <choice name="Bits per second"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="tempUnit" type="Enum">
            <label>Temperature Units</label>
            <choices>
                <choice name="Celsius °C"/>
                <choice name="Fahrenheit °F"/>
            </choices>
            <default>0</default>
        </entry>

        <!-- System Section -->
        <entry name="cpuTempMode" type="Enum">
            <label>CPU temperature display</label>
            <choices>
                <choice name="Per core"/>
                <choice name="Average"/>
                <choice name="Maximum"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="groupCpuTemperatures" type="Bool">
            <label>Group logical CPUs by physical core</label>
            <default>false</default>
        </entry>
        <entry name="cpuHighTemp" type="Int">
            <label>CPU High Temperature</label>
            <default>60</default>
        </entry>
        <entry name="cpuCritTemp" type="Int">
            <label>CPU Critical Temperature</label>
            <default>70</default>
        </entry>

        <!-- Style Section -->
        <entry name="coloredCpuLoad" type="Bool">
            <label>Colored CPU load indicators.</label>
            <default>true</default>
        </entry>
        <entry name="flatCpuLoad" type="Bool">
            <label>Flat CPU load indicators.</label>
            <default>true</default>
        </entry>
        <entry name="indicatorHeight" type="Int">
            <label>Height of CPU load indicators.</label>
            <default>10</default>
        </entry>

        <!-- Performance Section -->
        <entry name="updateInterval" type="Double">
            <label>Update interval in seconds.</label>
            <default>1.0</default>
        </entry>
    </group>
</kcfg>
