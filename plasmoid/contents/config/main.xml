<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
     http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <!-- Skins Section -->
        <entry name="skin" type="Enum">
            <label>Skin type</label>
            <choices>
                <choice name="Standard"/>
                <choice name="Column"/>
                <choice name="Minimalistic"/>
            </choices>
            <default>0</default>
        </entry>

        <!-- Background Section -->
        <entry name="bgColor" type="Enum">
            <label>Background color</label>
            <choices>
                <choice name="Standard"/>
                <choice name="Crystal"/>
                <choice name="Translucent"/>
            </choices>
            <default>1</default>
        </entry>

        <!-- Logos Section -->
        <entry name="logo" type="Enum">
            <label>Distribution logo</label>
            <choices>
                <choice name="Default"/>
                <choice name="Tux"/>
                <choice name="Slackware"/>
                <choice name="Ubuntu"/>
                <choice name="Kubuntu"/>
                <choice name="OpenSUSE"/>
                <choice name="Manjaro"/>
                <choice name="Arch"/>
                <choice name="Fedora"/>
                <choice name="Debian"/>
                <choice name="Linux Mint"/>
                <choice name="EndeavourOS"/>
                <choice name="Pop!_OS"/>
                <choice name="Zorin OS"/>
                <choice name="elementary OS"/>
                <choice name="NixOS"/>
                <choice name="Gentoo"/>
                <choice name="Alpine"/>
                <choice name="Void"/>
                <choice name="Rocky"/>
                <choice name="AlmaLinux"/>
                <choice name="Red Hat"/>
                <choice name="CentOS"/>
                <choice name="Kali"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="logoScale" type="Double">
            <label>Logo scaling</label>
            <default>1.0</default>
        </entry>

        <!-- Displays Section -->
        <entry name="showGpuTemp" type="Bool">
            <label>Show GPU Temperature</label>
            <default>true</default>
        </entry>
        <entry name="showSwap" type="Bool">
            <label>Show Swap</label>
            <default>true</default>
        </entry>
        <entry name="showUptime" type="Bool">
            <label>Show Uptime</label>
            <default>true</default>
        </entry>
        <entry name="showNetwork" type="Bool">
            <label>Show Network</label>
            <default>true</default>
        </entry>
        <entry name="netUnit" type="Enum">
            <label>Network speed unit</label>
            <choices>
                <choice name="Bytes per second"/>
                <choice name="Bits per second"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="tempUnit" type="Enum">
            <label>Temperature Units</label>
            <choices>
                <choice name="Celsius °C"/>
                <choice name="Fahrenheit °F"/>
            </choices>
            <default>0</default>
        </entry>

        <!-- System Section -->
        <entry name="cpuTempMode" type="Enum">
            <label>CPU temperature display</label>
            <choices>
                <choice name="Per core"/>
                <choice name="Average"/>
                <choice name="Maximum"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="cpuHighTemp" type="Int">
            <label>CPU High Temperature</label>
            <default>60</default>
        </entry>
        <entry name="cpuCritTemp" type="Int">
            <label>CPU Critical Temperature</label>
            <default>70</default>
        </entry>

        <!-- Style Section -->
        <entry name="coloredCpuLoad" type="Bool">
            <label>Colored CPU load indicators.</label>
            <default>true</default>
        </entry>
        <entry name="flatCpuLoad" type="Bool">
            <label>Flat CPU load indicators.</label>
            <default>true</default>
        </entry>
        <entry name="indicatorHeight" type="Int">
            <label>Height of CPU load indicators.</label>
            <default>10</default>
        </entry>

        <!-- Performance Section -->
        <entry name="updateInterval" type="Double">
            <label>Update interval in seconds.</label>
            <default>1.0</default>
        </entry>
    </group>
</kcfg>
